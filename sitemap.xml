---
layout: null
sitemap: false
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  {% for entry in site.html_pages %}
  {% unless entry.sitemap == false %}
  {% if entry.url == '/' or entry.title %}
  <url><loc>{{ entry.url | replace: 'index.html', '' | absolute_url | xml_escape }}</loc></url>
  {% endif %}
  {% endunless %}
  {% endfor %}
  {% for entry in site.posts %}
  {% unless entry.sitemap == false %}
  <url>
    <loc>{{ entry.url | absolute_url | xml_escape }}</loc>
    <lastmod>{{ entry.last_modified_at | default: entry.date | date_to_xmlschema }}</lastmod>
  </url>
  {% endunless %}
  {% endfor %}
</urlset>
