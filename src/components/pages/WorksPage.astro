---
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { url } from "@utils/url-utils";
import type { MarkdownHeading } from "astro";
import { Icon } from "astro-icon/components";
import { workCategories } from "../../data/works";
import { getWorksText } from "../../data/works.ja";

const lang = Astro.locals.lang;
const isJapanese = lang.toLowerCase().startsWith("ja");
const t = (text: string) => getWorksText(text, lang);

const pageTitle = isJapanese ? "作品" : "Works";
const pageDescription = isJapanese
	? "ゲーム、ツール、映像・音声、3Dモデルまで——これまで制作に関わってきた作品の記録です。"
	: "游戏、工具、影音与 3D 模型——记录一路参与创作过的作品。";
const navAriaLabel = isJapanese
	? "作品カテゴリナビゲーション"
	: "作品分类导航";

const totalCount = workCategories.reduce(
	(sum, cat) => sum + cat.items.length,
	0,
);
const summaryCountText = isJapanese
	? `${totalCount} 作品 · ${workCategories.length} カテゴリ`
	: `${totalCount} 件作品 · ${workCategories.length} 个分类`;

const headings: MarkdownHeading[] = workCategories.map((cat) => ({
	depth: 2,
	slug: cat.id,
	text: t(cat.title),
}));

const zhUrl = new URL(url("/works/"), Astro.site);
const jaUrl = new URL(url("/ja/works/"), Astro.site);
---
<MainGridLayout title={pageTitle} description={pageDescription} lang={lang} headings={headings}>
	<Fragment slot="head">
		<link rel="alternate" hreflang="zh-Hans" href={zhUrl} />
		<link rel="alternate" hreflang="ja" href={jaUrl} />
		<link rel="alternate" hreflang="x-default" href={zhUrl} />
	</Fragment>

	<div class="flex flex-col gap-4 w-full" data-pagefind-body>
		<!-- Header Card -->
		<section class="card-base px-6 md:px-9 py-6 rounded-[var(--radius-large)] onload-animation">
			<div class="flex flex-wrap items-baseline justify-between gap-3 mb-2">
				<h1
					class="relative font-bold text-2xl md:text-3xl text-black/90 dark:text-white/90
					md:before:w-1 before:h-6 before:rounded-md before:bg-[var(--primary)]
					before:absolute before:top-1/2 before:-translate-y-1/2 before:left-[-1.125rem]"
				>
					{pageTitle}
				</h1>
				<span class="text-xs md:text-sm px-2.5 py-1 rounded-full bg-black/5 dark:bg-white/10 text-black/60 dark:text-white/60">
					{summaryCountText}
				</span>
			</div>
			<p class="text-sm md:text-base text-black/65 dark:text-white/65 mb-5">
				{pageDescription}
			</p>

			<nav aria-label={navAriaLabel} class="flex flex-wrap gap-2">
				{workCategories.map((cat) => (
					<a
						href={`#${cat.id}`}
						class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs md:text-sm bg-black/5 dark:bg-white/10 hover:bg-[var(--btn-regular-bg-hover)] text-black/75 dark:text-white/75 hover:text-[var(--primary)] transition focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--primary)]"
					>
						<Icon name={cat.icon} class="text-xs opacity-75" aria-hidden="true" />
						<span>{t(cat.title)}</span>
						<span class="text-[11px] opacity-55">{cat.items.length}</span>
					</a>
				))}
			</nav>
		</section>

		<!-- All 6 Categories -->
		{workCategories.map((category) => {
			const mediaItems = category.items.filter((item) => Boolean(item.image));
			const textItems = category.items.filter((item) => !item.image);
			const hasOddMedia = mediaItems.length % 2 === 1;

			return (
				<section
					id={category.id}
					class="card-base px-6 md:px-9 py-6 rounded-[var(--radius-large)] scroll-mt-20 onload-animation"
				>
					<div class="flex items-center justify-between mb-4">
						<h2 class="text-xl font-bold text-black/90 dark:text-white/90 flex items-center gap-2.5">
							<span class="inline-flex items-center justify-center w-7 h-7 rounded-lg bg-[var(--btn-regular-bg)] text-[var(--primary)]">
								<Icon name={category.icon} class="text-sm" aria-hidden="true" />
							</span>
							<span>{t(category.title)}</span>
						</h2>
						<span class="text-xs px-2 py-0.5 rounded-full bg-black/5 dark:bg-white/10 text-black/50 dark:text-white/50">
							{isJapanese ? `${category.items.length} 件` : `${category.items.length} 项`}
						</span>
					</div>

					{mediaItems.length > 0 && (
						<div class:list={["grid grid-cols-1 md:grid-cols-2 gap-4", textItems.length > 0 && "mb-4"]}>
							{mediaItems.map((item, idx) => {
								const isWideLead = hasOddMedia && idx === 0;
								const itemTitle = t(item.title);
								const itemAlt = item.imageAlt ? t(item.imageAlt) : itemTitle;
								return (
									<article
										class:list={[
											"group flex flex-col rounded-xl overflow-hidden border border-[var(--line-divider)] bg-black/[0.02] dark:bg-white/[0.03] hover:border-[var(--primary)]/50 transition",
											isWideLead && "md:col-span-2 md:flex-row",
										]}
									>
										<div
											class:list={[
												"relative aspect-[16/9] overflow-hidden bg-black/5 dark:bg-white/5 shrink-0",
												isWideLead ? "w-full md:w-[46%] md:aspect-auto md:min-h-[12.5rem]" : "w-full",
											]}
										>
											{item.imageFit === "contain" ? (
												<>
													<img
														src={item.image}
														alt=""
														aria-hidden="true"
														loading="lazy"
														decoding="async"
														class="absolute inset-0 w-full h-full object-cover scale-110 blur-xl opacity-30 dark:opacity-25 pointer-events-none"
													/>
													<img
														src={item.image}
														alt={itemAlt}
														loading="lazy"
														decoding="async"
														class="relative z-10 h-full w-auto max-w-full mx-auto object-contain py-2.5 drop-shadow-md transition duration-500 group-hover:scale-[1.03]"
													/>
												</>
											) : (
												<img
													src={item.image}
													alt={itemAlt}
													loading="lazy"
													decoding="async"
													class="w-full h-full object-cover object-center transition duration-500 group-hover:scale-[1.03]"
												/>
											)}
										</div>

										<div class="flex flex-col flex-1 p-4 md:p-5">
											<div class="flex flex-wrap items-baseline justify-between gap-2 mb-1.5">
												<h3 class="text-lg font-bold text-black/90 dark:text-white/90 leading-snug">
													{itemTitle}
												</h3>
												{item.meta && (
													<span class="text-xs text-black/45 dark:text-white/45">
														{t(item.meta)}
													</span>
												)}
											</div>
											{item.summary && (
												<p class="text-sm text-black/65 dark:text-white/65 leading-relaxed mb-4 flex-1">
													{t(item.summary)}
												</p>
											)}
											<div class="flex flex-wrap gap-2 mt-auto">
												{item.links.map((link) => (
													<a
														aria-label={`${t(item.title)} - ${t(link.label)}`}
														href={link.href}
														target={link.external ? "_blank" : undefined}
														rel={link.external ? "noopener noreferrer" : undefined}
														class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-medium bg-[var(--btn-regular-bg)] hover:bg-[var(--btn-regular-bg-hover)] text-black/80 dark:text-white/85 hover:text-[var(--primary)] transition focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--primary)]"
													>
														{link.icon && <Icon name={link.icon} class="text-xs" aria-hidden="true" />}
														<span>{t(link.label)}</span>
													</a>
												))}
											</div>
										</div>
									</article>
								);
							})}
						</div>
					)}

					{textItems.length > 0 && (
						<ul class:list={["grid grid-cols-1 gap-3", textItems.length > 1 && "sm:grid-cols-2"]}>
							{textItems.map((item) => (
								<li class="flex flex-col justify-between gap-2.5 p-3.5 rounded-xl border border-[var(--line-divider)] bg-black/[0.015] dark:bg-white/[0.02] hover:border-[var(--primary)]/40 transition">
									<div>
										<h3 class="font-semibold text-sm md:text-base text-black/85 dark:text-white/90 leading-snug">
											{t(item.title)}
										</h3>
										{item.summary && (
											<p class="text-xs text-black/55 dark:text-white/55 mt-1 leading-relaxed">
												{t(item.summary)}
											</p>
										)}
									</div>
									<div class="flex flex-wrap gap-1.5">
										{item.links.map((link) => (
											<a
												aria-label={`${t(item.title)} - ${t(link.label)}`}
												href={link.href}
												target={link.external ? "_blank" : undefined}
												rel={link.external ? "noopener noreferrer" : undefined}
												class="inline-flex items-center gap-1 px-2.5 py-1 rounded-md text-xs bg-black/5 dark:bg-white/10 hover:bg-[var(--btn-regular-bg-hover)] text-black/75 dark:text-white/80 hover:text-[var(--primary)] transition focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--primary)]"
											>
												<span>{t(link.label)}</span>
												{link.external && (
													<Icon name="fa6-solid:arrow-up-right-from-square" class="text-[10px] opacity-60" aria-hidden="true" />
												)}
											</a>
										))}
									</div>
								</li>
							))}
						</ul>
					)}
				</section>
			);
		})}
	</div>
</MainGridLayout>
