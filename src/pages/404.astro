---
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { url } from "@utils/url-utils";
---
<MainGridLayout title="404" description="你来到了没有知识的荒原 :(">
    <Fragment slot="head">
        <meta name="robots" content="noindex" />
    </Fragment>

    <div class="card-base px-6 md:px-9 py-12 rounded-[var(--radius-large)] w-full text-center onload-animation">
        <div class="text-6xl md:text-7xl font-bold text-[var(--primary)] mb-4">404</div>
        <h1 class="text-xl md:text-2xl font-bold text-black/85 dark:text-white/85 mb-3">
            你来到了没有知识的荒原 :(
        </h1>
        <p class="text-sm text-black/55 dark:text-white/55 mb-8">
            访问的页面不存在或已被移动，可以返回首页或前往归档页继续浏览。
        </p>
        <div class="flex flex-wrap items-center justify-center gap-3">
            <a
                href={url("/")}
                class="btn-regular rounded-lg h-11 px-6 font-bold text-sm active:scale-95"
            >
                返回首页
            </a>
            <a
                href={url("/archive/")}
                class="btn-plain scale-animation rounded-lg h-11 px-6 font-bold text-sm active:scale-95"
            >
                浏览归档
            </a>
        </div>
    </div>
</MainGridLayout>
