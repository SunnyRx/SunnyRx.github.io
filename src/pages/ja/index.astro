---
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { getSortedJapanesePosts } from "@utils/content-utils";
import { getPostUrlBySlug } from "@utils/url-utils";
import { formatDateToYYYYMMDD } from "../../utils/date-utils";

const jaPosts = await getSortedJapanesePosts();
---
<MainGridLayout title="日本語の記事" description="日本語版のブログ記事一覧" lang="ja">
    <div class="card-base px-6 md:px-9 py-6 rounded-[var(--radius-large)] w-full onload-animation">
        <h1 class="text-2xl md:text-3xl font-bold text-black/90 dark:text-white/90 mb-2">
            日本語の記事
        </h1>
        <p class="text-sm text-black/55 dark:text-white/55 mb-6">
            中国語版から翻訳・執筆した日本語記事の一覧です。
        </p>

        {jaPosts.length === 0 ? (
            <div class="rounded-xl border border-dashed border-[var(--line-divider)] p-6 text-black/60 dark:text-white/60 text-sm">
                日本語の記事はまだ公開されていません。<code class="mx-1">src/content/posts/ja/</code> に Markdown ファイルを追加し、対応する中国語記事と同じ <code class="mx-1">translationKey</code> を設定すると、ここに一覧表示され相互リンクが自動生成されます。
            </div>
        ) : (
            <ul class="space-y-4">
                {jaPosts.map((post) => (
                    <li class="border-b border-dashed border-[var(--line-divider)] pb-4 last:border-b-0 last:pb-0">
                        <a href={getPostUrlBySlug(post.slug)} class="group block">
                            <div class="text-xs text-black/45 dark:text-white/45 mb-1">
                                {formatDateToYYYYMMDD(post.data.published)}
                            </div>
                            <div class="text-lg font-bold text-black/85 dark:text-white/85 group-hover:text-[var(--primary)] transition">
                                {post.data.title}
                            </div>
                            {post.data.description && (
                                <p class="text-sm text-black/60 dark:text-white/60 mt-1">
                                    {post.data.description}
                                </p>
                            )}
                        </a>
                    </li>
                ))}
            </ul>
        )}
    </div>
</MainGridLayout>
